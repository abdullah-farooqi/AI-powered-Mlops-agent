# ==========================================
# MLOps AI Agent Environment Configuration
# ==========================================

# MLflow Tracking Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=mlops-model-training
MLFLOW_HTTP_REQUEST_TIMEOUT=3
MLFLOW_HTTP_REQUEST_MAX_RETRIES=1

# Apache Airflow Configuration (Supports Airflow 2 and 3)
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_JWT_TOKEN=

# Kubernetes Configuration
K8S_NAMESPACE=mlops-app
ALLOWED_NAMESPACE=mlops-app
KUBECONFIG=~/.kube/config

# DVC & Data Configuration
DATA_PATH=data/raw_data.csv
DVC_REMOTE_NAME=local_remote
DVC_REMOTE_URL=/tmp/dvc-storage

# Optional LLM API Configuration (OpenAI / Anthropic / Gemini)
# Leave blank to use built-in intelligent function calling simulator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
